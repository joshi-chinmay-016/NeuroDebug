# Git ignore patterns for NeuroDebug

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Database files
*.db
*.sqlite
*.sqlite3
backend/*.db

# Environment / secrets
.env
.env.*
!.env.example

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
*.log

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Linters / Cache
.ruff_cache/*
.ruff_cache/

# Local wrapper scripts
powershell.cmd
**/powershell.cmd